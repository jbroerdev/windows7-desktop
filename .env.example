EXPLORER_PORT=3000
EXPLORER_BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=0
# Host directory; the container path always remains /Explorer. No named volumes.
EXPLORER_PATH=/Explorer

# Optional Office: start with -f compose.office.yaml (see DOCKER-OFFICE.md)
# OFFICE_URL=https://office.xserverx.app
# EXPLORER_PUBLIC_URL=https://explorer.xserverx.app
# COLLABORA_SERVER_NAME=office.xserverx.app
# COLLABORA_BIND_ADDRESS=127.0.0.1
# COLLABORA_PORT=9980
# COLLABORA_SSL_TERMINATION=true

# Browser-compatible H.264/AAC fallback (limits help small Docker hosts)
FFMPEG_ENABLED=1
FFMPEG_THREADS=2
FFMPEG_MAX_WIDTH=1280
FFMPEG_MAX_HEIGHT=720
FFMPEG_MAX_PROCESSES=2
FFMPEG_STARTUP_TIMEOUT=30

# Optional separate Live Mail service (compose.mail.yaml)
# MAIL_SERVICE_SECRET=<random secret, at least 32 characters, shared by both services>

# Optional separate Messenger service (compose.messenger.yaml); see LIVE-MESSENGER.md
MESSENGER_SERVICE_SECRET=
MESSENGER_PUBLIC_URL=
DISCORD_BOT_TOKEN=
DISCORD_PERSONAL_CHANNEL_ID=
DISCORD_SHARE_CHANNEL_ID=

# Optional separate Remote Desktop service (compose.rdp.yaml); see REMOTE-DESKTOP.md
# RDP_SERVICE_SECRET=<at least 32 random characters, shared by desktop and broker>
# RDP_ALLOWED_TARGETS=rdp.example.net:3389,192.168.1.20:3389

# Optional Super Mario 64 service (compose.sm64.yaml; private EU build only)
SM64_SERVICE_URL=
SM64_BUILD_DIR=./services/sm64/build

# Optional YouTube frontend (compose.youtube.yaml; services/youtube/README.md)
# YOUTUBE_SERVICE_SECRET=<at least 32 random characters>
# YOUTUBE_CACHE_GB=2
